{
  "name": "l1dder",
  "version": "1.3.0",
  "description": "Spec-driven development framework for AI coding agents (Cursor, Claude Code, Codex, Windsurf, Copilot, OpenCode, Cline): ideas, specs and roadmap in Markdown, driven by /l1-* slash commands.",
  "keywords": [
    "l1dder",
    "spec-driven",
    "spec-driven-development",
    "ai",
    "ai-agents",
    "ai-coding",
    "agentic-coding",
    "coding-agents",
    "vibe-coding",
    "cursor",
    "claude-code",
    "codex",
    "windsurf",
    "copilot",
    "opencode",
    "cline",
    "workflow",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "author": "Oleg Ledvanov",
  "homepage": "https://ledvanoff.github.io/l1dder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ledvanoff/l1dder.git"
  },
  "bugs": {
    "url": "https://github.com/ledvanoff/l1dder/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "l1dder": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "build": "node scripts/sync-release-meta.mjs && tsup && node scripts/sync-root-l1dder.mjs && node scripts/sync-site-docs.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playground:prepare": "node playground/prepare.mjs",
    "playground:verify": "node playground/verify.mjs",
    "docs:dev": "node scripts/sync-site-docs.mjs && vitepress dev site",
    "docs:build": "node scripts/sync-site-docs.mjs && vitepress build site",
    "docs:preview": "vitepress preview site"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "mermaid": "^11.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitepress": "^1.5.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.0.0"
  }
}
